# 1. 忽略所有文件和文件夹
*

# 2. 允许目录结构
!*/

# 3. 白名单 (基础文件类型)
!*.java
!*.py
!*.xml
!*.txt
!README.md
!README_EN.md
!.gitignore
!aiknowledge.txt

# ==========================================
# 新增：显式放行整个 config 核心配置目录及其内部所有文件
# ==========================================
# 先允许 Git 扫描 config 文件夹本身
!config/
# 再允许 Git 扫描 config 目录下的所有子文件夹结构
!config/**/
# 最后精准放行 config 目录下所有层级的 .txt 和 .conf 文件
!config/**/*.txt
!config/**/*.conf

# 4. CI 相关
!.github/
!.github/workflows/*.yml
!ci-config-template/
!ci-config-template/**.idea

# 5. 显式黑名单（即便符合白名单也要强制忽略的文件）
git-command.txt
maven-linux命令.txt
ollama.txt
postgres.txt

# 前端源码放行（web/src 下的组件/脚本/样式，排除 node_modules 和构建产物）
!web/src/
!web/src/**/
!web/src/**/*.jsx
!web/src/**/*.js
!web/src/**/*.ts
!web/src/**/*.tsx
!web/src/**/*.css
!web/src/**/*.json
!web/package.json
!web/vite.config.js